<Window x:Class="RadialActions.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:RadialActions"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Radial Actions settings"
        Width="1040" Height="760"
        MinWidth="720" MinHeight="500"
        d:DataContext="{d:DesignInstance Type=local:SettingsWindowViewModel}"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  The banner shares the pages' capped content column so its right edge lines up with the cards; its vertical margin stays on the banner so the row takes no space while it's collapsed  -->
        <Grid Grid.Row="0"
              Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"
                                  MaxWidth="{StaticResource PageMaxContentWidth}" />
            </Grid.ColumnDefinitions>
            <Border x:Name="UpdateBanner"
                    Margin="0,8,0,4"
                    Binding.TargetUpdated="UpdateBanner_TargetUpdated"
                    Style="{StaticResource InfoBarBorderStyle}"
                    Visibility="{Binding IsUpdateAvailable, Source={x:Static local:App.CurrentApp}, Converter={local:BooleanToVisibilityConverter}, NotifyOnTargetUpdated=True}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0"
                          Margin="0,0,12,0" VerticalAlignment="Center">
                        <Ellipse Style="{StaticResource InfoBarIconDiscStyle}" />
                        <ContentControl Content="&#xE896;"
                                        Style="{StaticResource InfoBarIconGlyphStyle}" />
                    </Grid>
                    <WrapPanel Grid.Column="1"
                               VerticalAlignment="Center">
                        <TextBlock Text="Update available"
                                   Margin="0,0,12,0"
                                   Style="{StaticResource BodyStrongTextStyle}"
                                   TextWrapping="NoWrap" />
                        <TextBlock x:Name="UpdateBannerMessage"
                                   Text="{Binding LatestVersion, Source={x:Static local:App.CurrentApp}, Mode=OneWay, Converter={local:VersionTextConverter}, StringFormat='Version {0} is ready to download.'}"
                                   AutomationProperties.LiveSetting="Polite"
                                   Style="{StaticResource BodyTextStyle}" />
                    </WrapPanel>
                    <Button Grid.Column="2"
                            Content="Download"
                            Margin="16,0,0,0" VerticalAlignment="Center"
                            Click="DownloadUpdateButton_Click" />
                </Grid>
            </Border>
        </Grid>

        <TabControl Grid.Row="1"
                    Margin="16,0,16,0"
                    ItemContainerStyle="{StaticResource SelectorTabItemStyle}"
                    SelectedIndex="{Binding Settings.SettingsTabIndex, Mode=TwoWay}"
                    Style="{StaticResource SelectorTabControlStyle}">
            <TabItem Header="_General">
                <local:GeneralSettingsView DataContext="{Binding General}" />
            </TabItem>

            <TabItem Header="_Actions">
                <local:ActionsSettingsView x:Name="ActionsView"
                                           DataContext="{Binding Actions}" />
            </TabItem>

            <TabItem Header="Ab_out">
                <local:AboutSettingsView DataContext="{Binding About}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
