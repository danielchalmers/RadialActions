<UserControl x:Class="RadialActions.PieControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="300"
             d:DesignWidth="300"
             AutomationProperties.HelpText="Use the arrow keys to choose a slice, then press Enter to run it. Number keys 1 to 9 run slices directly. Shift+F10 opens more options, and Esc closes the menu."
             AutomationProperties.Name="Radial Actions menu"
             ClipToBounds="False"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PieTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Canvas Name="PieCanvas"
            ClipToBounds="False"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True" />
</UserControl>
