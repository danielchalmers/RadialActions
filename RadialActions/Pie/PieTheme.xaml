<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        Pie palette. These are app-owned values tuned for the floating menu, not Fluent tokens.
        PieThemeSnapshot picks the .Light or .Dark variant from the app theme; high contrast ignores them and uses system colors.
        Motion (durations and easings) and the accent come from the app design system (Themes/AppTheme.xaml and the Fluent accent).
    -->

    <!--  Slice fill, also used for the surface ring behind the slices so a pressed slice never reveals a second tone  -->
    <SolidColorBrush x:Key="PieSliceFillBrush.Light"
                     Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PieSliceFillBrush.Dark"
                     Color="#FF2C2C2C" />

    <!--  Hovered or keyboard-selected slice, and the hovered hub  -->
    <SolidColorBrush x:Key="PieSliceHoverBrush.Light"
                     Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="PieSliceHoverBrush.Dark"
                     Color="#FF3B3B3B" />

    <!--  Pressed slice: one calmer step between rest and hover in both themes  -->
    <SolidColorBrush x:Key="PieSlicePressedBrush.Light"
                     Color="#FFF6F6F6" />
    <SolidColorBrush x:Key="PieSlicePressedBrush.Dark"
                     Color="#FF333333" />

    <!--  Hub fill, a slightly recessed tone so the center reads as its own target  -->
    <SolidColorBrush x:Key="PieHubFillBrush.Light"
                     Color="#FFF9F9F9" />
    <SolidColorBrush x:Key="PieHubFillBrush.Dark"
                     Color="#FF282828" />

    <!--  One stroke for the slice separators, the rim and the hub border  -->
    <SolidColorBrush x:Key="PieStrokeBrush.Light"
                     Color="#FFD9D9D9" />
    <SolidColorBrush x:Key="PieStrokeBrush.Dark"
                     Color="#FF4D4D4D" />

    <!--  Slice labels  -->
    <SolidColorBrush x:Key="PieTextBrush.Light"
                     Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="PieTextBrush.Dark"
                     Color="#FFEBEBEB" />

    <!--  Secondary text and glyphs (digit hints, resting hub glyph): at least 4.5:1 on the rest and hover fills  -->
    <SolidColorBrush x:Key="PieHintTextBrush.Light"
                     Color="#FF616161" />
    <SolidColorBrush x:Key="PieHintTextBrush.Dark"
                     Color="#FFA6A6A6" />

    <!--  Geometry and spacing  -->
    <sys:Double x:Key="PieSliceStrokeThickness">1</sys:Double>
    <sys:Double x:Key="PieHubStrokeThickness">1</sys:Double>
    <sys:Double x:Key="PieSelectionArcThickness">3</sys:Double>
    <sys:Double x:Key="PieIconToLabelSpacing">3</sys:Double>
    <Thickness x:Key="PieSliceContentPadding">2,2,2,2</Thickness>

    <!--  Floating-panel depth shadow; dark surfaces need a stronger shadow to separate from the content behind  -->
    <Color x:Key="PieShadowColor">#FF000000</Color>
    <DropShadowEffect x:Key="PieAmbientShadowEffect.Light"
                      BlurRadius="32"
                      Color="{StaticResource PieShadowColor}"
                      Direction="270"
                      Opacity="0.14"
                      RenderingBias="Quality"
                      ShadowDepth="4" />
    <DropShadowEffect x:Key="PieAmbientShadowEffect.Dark"
                      BlurRadius="32"
                      Color="{StaticResource PieShadowColor}"
                      Direction="270"
                      Opacity="0.26"
                      RenderingBias="Quality"
                      ShadowDepth="4" />

    <!--  Element styles. They carry the base sizes for a default (400px) menu; code scales them for larger menus and sets theme colors.  -->
    <Style x:Key="PieSlicePathStyle"
           TargetType="{x:Type Path}">
        <Setter Property="StrokeStartLineCap"
                Value="Round" />
        <Setter Property="StrokeEndLineCap"
                Value="Round" />
        <Setter Property="StrokeLineJoin"
                Value="Round" />
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
    </Style>

    <Style x:Key="PieSelectionArcStyle"
           TargetType="{x:Type Path}">
        <Setter Property="StrokeStartLineCap"
                Value="Round" />
        <Setter Property="StrokeEndLineCap"
                Value="Round" />
        <Setter Property="IsHitTestVisible"
                Value="False" />
    </Style>

    <Style x:Key="PieHubContainerStyle"
           TargetType="{x:Type Grid}">
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <Setter Property="UseLayoutRounding"
                Value="True" />
    </Style>

    <Style x:Key="PieHubEllipseStyle"
           TargetType="{x:Type Ellipse}">
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
    </Style>

    <Style x:Key="PieIconTextStyle"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize"
                Value="20" />
        <Setter Property="FontWeight"
                Value="Normal" />
        <Setter Property="TextAlignment"
                Value="Center" />
        <Setter Property="TextWrapping"
                Value="NoWrap" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="PieLabelTextStyle"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="TextAlignment"
                Value="Center" />
        <Setter Property="TextWrapping"
                Value="NoWrap" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <!--  Number-key hint at the rim  -->
    <Style x:Key="PieHintTextStyle"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize"
                Value="11" />
        <Setter Property="FontWeight"
                Value="Normal" />
        <Setter Property="TextAlignment"
                Value="Center" />
        <Setter Property="TextWrapping"
                Value="NoWrap" />
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
    </Style>

    <!--  Release hint glyph at the rim; the symbol font itself is resolved from SymbolThemeFontFamily in code  -->
    <Style x:Key="PieGlyphTextStyle"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="TextAlignment"
                Value="Center" />
        <Setter Property="TextWrapping"
                Value="NoWrap" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
    </Style>

    <!--  Hub close glyph; the base size for a default menu, which code scales with the rest of the pie content  -->
    <Style x:Key="PieHubGlyphTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource PieGlyphTextStyle}">
        <Setter Property="FontSize"
                Value="16" />
    </Style>
</ResourceDictionary>
