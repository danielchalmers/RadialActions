<Window x:Class="RadialActions.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:RadialActions"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:p="clr-namespace:RadialActions.Properties"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Radial Actions"
        d:DataContext="{d:DesignInstance Type=local:MainWindow}"
        AllowsTransparency="True" AutomationProperties.Name="Radial Actions menu"
        Background="Transparent" Deactivated="Window_Deactivated"
        Loaded="Window_Loaded" Opacity="0"
        PreviewKeyDown="Window_KeyDown" PreviewKeyUp="Window_KeyUp"
        ResizeMode="NoResize" ShowActivated="False"
        ShowInTaskbar="False" SizeToContent="WidthAndHeight"
        Topmost="True" Unloaded="Window_Unloaded"
        WindowStyle="None"
        mc:Ignorable="d">
    <Window.Resources>
        <!--  Entrance: fade in while the pie grows from MotionMenuEnterScale, which MenuService sets before a fresh show so a reopen during the exit continues from the current scale  -->
        <Storyboard x:Key="FadeInStoryboard"
                    Completed="FadeInStoryboard_Completed">
            <DoubleAnimation EasingFunction="{StaticResource MotionEaseDecelerate}"
                             Storyboard.TargetProperty="Opacity"
                             To="1"
                             Duration="{StaticResource MotionDurationMenuEnter}" />
            <DoubleAnimation EasingFunction="{StaticResource MotionEaseDecelerate}"
                             Storyboard.TargetName="PieMenu"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             To="1"
                             Duration="{StaticResource MotionDurationMenuEnter}" />
            <DoubleAnimation EasingFunction="{StaticResource MotionEaseDecelerate}"
                             Storyboard.TargetName="PieMenu"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             To="1"
                             Duration="{StaticResource MotionDurationMenuEnter}" />
        </Storyboard>

        <Storyboard x:Key="FadeOutStoryboard"
                    Completed="FadeOutStoryboard_Completed">
            <DoubleAnimation EasingFunction="{StaticResource MotionEaseAccelerate}"
                             Storyboard.TargetProperty="Opacity"
                             To="0"
                             Duration="{StaticResource MotionDurationMenuExit}" />
            <DoubleAnimation EasingFunction="{StaticResource MotionEaseAccelerate}"
                             Storyboard.TargetName="PieMenu"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             To="{StaticResource MotionMenuExitScale}"
                             Duration="{StaticResource MotionDurationMenuExit}" />
            <DoubleAnimation EasingFunction="{StaticResource MotionEaseAccelerate}"
                             Storyboard.TargetName="PieMenu"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             To="{StaticResource MotionMenuExitScale}"
                             Duration="{StaticResource MotionDurationMenuExit}" />
        </Storyboard>

        <!--  Shared by the tray icon and the pie's center; the pie's copy hides "Open menu" because the menu is already open  -->
        <ContextMenu x:Key="MainContextMenu" x:Shared="False">
            <MenuItem Header="Open _menu"
                      Click="OnOpenMenuItemClick" Tag="OpenMenu">
                <MenuItem.Style>
                    <!--  Shows the hotkey only while it opens the menu, so a combination another app owns isn't advertised  -->
                    <Style TargetType="MenuItem"
                           BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="InputGestureText" Value="{Binding ActivationHotkey, Source={x:Static p:Settings.Default}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasActivationHotkeyError, Source={x:Static local:App.CurrentApp}}"
                                         Value="True">
                                <Setter Property="InputGestureText" Value="" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
                <MenuItem.Icon>
                    <ContentControl Content="&#xE8A9;"
                                    Style="{StaticResource MenuItemIconStyle}" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="_Settings"
                      Click="OnTraySettingsMenuItemClick" Tag="0">
                <MenuItem.Icon>
                    <ContentControl Content="&#xE713;"
                                    Style="{StaticResource MenuItemIconStyle}" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="_Actions"
                      Click="OnTraySettingsMenuItemClick" Tag="1">
                <MenuItem.Icon>
                    <ContentControl Content="&#xE71D;"
                                    Style="{StaticResource MenuItemIconStyle}" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="Ab_out"
                      Click="OnTraySettingsMenuItemClick" Tag="2">
                <MenuItem.Icon>
                    <ContentControl Content="&#xE946;"
                                    Style="{StaticResource MenuItemIconStyle}" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="Send _feedback"
                      Click="OnTrayFeedbackMenuItemClick">
                <MenuItem.Icon>
                    <ContentControl Content="&#xED15;"
                                    Style="{StaticResource MenuItemIconStyle}" />
                </MenuItem.Icon>
            </MenuItem>

            <Separator />

            <MenuItem Header="E_xit"
                      Click="OnTrayExitMenuItemClick">
                <MenuItem.Icon>
                    <ContentControl Content="&#xE711;"
                                    Style="{StaticResource MenuItemIconStyle}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <tb:TaskbarIcon x:Key="TrayIcon" x:Shared="False"
                        IconSource="RadialActions.ico" MenuActivation="RightClick"
                        ToolTipText="Radial Actions" TrayBalloonTipClicked="OnTrayBalloonTipClicked"
                        TrayKeyboardKeySelect="OnTrayKeyboardKeySelect"
                        TrayLeftMouseClick="OnTrayLeftMouseDown"
                        TrayLeftMouseDoubleClick="OnTrayLeftMouseDoubleClick" />
    </Window.Resources>

    <local:PieControl x:Name="PieMenu"
                      Width="{Binding Size, Source={x:Static p:Settings.Default}}"
                      Height="{Binding Size, Source={x:Static p:Settings.Default}}"
                      Margin="28"
                      CenterClicked="OnCenterClicked"
                      CenterContextMenuRequested="OnCenterContextMenuRequested"
                      RenderTransformOrigin="0.5,0.5" SliceClicked="OnSliceClicked"
                      SliceEditRequested="OnSliceEditRequested"
                      Slices="{Binding Actions, Source={x:Static p:Settings.Default}}"
                      SlicesReordered="OnSlicesReordered">
        <local:PieControl.RenderTransform>
            <ScaleTransform />
        </local:PieControl.RenderTransform>
    </local:PieControl>
</Window>
