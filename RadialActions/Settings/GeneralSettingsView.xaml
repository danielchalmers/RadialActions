<UserControl x:Class="RadialActions.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:RadialActions"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=local:GeneralSettingsViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RadialActions;component/Settings/SettingsViewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820"
                    Margin="24,16,24,24">
            <TextBlock Style="{StaticResource PageTitleTextBlock}"
                       Text="General" />

            <TextBlock Margin="1,0,0,8"
                       Style="{StaticResource SectionHeaderTextBlock}"
                       Text="Menu" />

            <local:SettingsCard Glyph="&#xE765;"
                                Header="Activation hotkey"
                                Description="Click the box, then press a key combination such as Ctrl+Alt+Space.">
                <TextBox Width="180"
                         Tag="HotkeyInput"
                         Text="{Binding Settings.ActivationHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </local:SettingsCard>

            <local:SettingsCard Glyph="&#xE740;"
                                Header="Menu size"
                                Description="Diameter in pixels. 300 to 500 works well on most screens.">
                <TextBox Width="100"
                         Text="{Binding Settings.Size, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </local:SettingsCard>

            <local:SettingsCard Glyph="&#xE81D;"
                                Header="Open at screen center"
                                Description="Open at the center of the screen instead of at the pointer.">
                <CheckBox AutomationProperties.Name="Open at screen center"
                          IsChecked="{Binding Settings.OpenMenuInScreenCenter, Mode=TwoWay}" />
            </local:SettingsCard>

            <local:SettingsCard Glyph="&#xE840;"
                                Header="Keep menu open after running an action"
                                Description="The menu stays open until you press Escape or click away.">
                <CheckBox AutomationProperties.Name="Keep menu open after running an action"
                          IsChecked="{Binding Settings.KeepMenuOpenAfterSliceClick, Mode=TwoWay}" />
            </local:SettingsCard>

            <TextBlock Style="{StaticResource SectionHeaderTextBlock}"
                       Text="System" />

            <local:SettingsCard Glyph="&#xE7E8;"
                                Header="Run at Windows startup"
                                Description="Start in the background when you sign in.">
                <CheckBox AutomationProperties.Name="Run at Windows startup"
                          IsChecked="{Binding Settings.RunOnStartup, Mode=TwoWay}" />
            </local:SettingsCard>

            <local:SettingsCard Glyph="&#xE895;"
                                Header="Check for updates automatically"
                                Description="Look for new versions on GitHub when the app starts.">
                <CheckBox AutomationProperties.Name="Check for updates automatically"
                          IsChecked="{Binding Settings.CheckForUpdatesOnStartup, Mode=TwoWay}" />
            </local:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
