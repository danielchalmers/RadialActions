<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Radial Actions"
           Manufacturer="Daniel Chalmers"
           Version="!(bind.FileVersion.RadialActions.exe)"
           UpgradeCode="EB19552B-9520-4638-9459-D2D257B52D05"
           Scope="perUser">
    <Property Id="ARPNOMODIFY" Value="1" />
    <Icon Id="RadialActions.ico" SourceFile="RadialActions/RadialActions.ico" />
    <Property Id="ARPPRODUCTICON" Value="RadialActions.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/danielchalmers/RadialActions" />
    <Property Id="ARPHELPLINK" Value="https://github.com/danielchalmers/RadialActions/issues" />
    <!--  Skip the System Restore point, which can hold the installer at "Please wait" for most of a minute and protects nothing in a per-user app folder  -->
    <Property Id="MSIFASTINSTALL" Value="1" />
    <!--  Keep the default schedule: in a per-user install without elevation, rolling back an in-transaction removal (afterInstallInitialize) restores the old files but not the old product's registration, leaving a copy no update or uninstall can find  -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="!(loc.WixDowngradePreventedMessage)" />
    <MediaTemplate EmbedCab="yes" />

    <!--  Not WiX's default INSTALLFOLDER under Programs: the settings file lives next to the exe, so moving the app would lose it  -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="RadialActionsRoot" Name="RadialActions">
        <Directory Id="INSTALLFOLDER" Name="RadialActions" />
      </Directory>
    </StandardDirectory>

    <File Id="RadialActions.exe" Source="publish/$(sys.BUILDARCH)/RadialActions.exe" />
    <!--  Settings next to the exe must never be installer-owned, or an upgrade deletes them  -->
    <Files Include="publish/$(sys.BUILDARCH)/**">
      <Exclude Files="publish/$(sys.BUILDARCH)/RadialActions.exe" />
      <Exclude Files="publish/$(sys.BUILDARCH)/*.settings*" />
    </Files>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component>
        <Shortcut Name="Radial Actions"
                  Target="[INSTALLFOLDER]RadialActions.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\Daniel Chalmers\RadialActions"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <RemoveFolder Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Directory="RadialActionsRoot" On="uninstall" />
      </Component>
    </StandardDirectory>

    <!--  Started through Explorer so the app gets the user's environment, including their PATH, instead of the Windows Installer service's  -->
    <CustomAction Id="LaunchApp"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[WindowsFolder]explorer.exe&quot; &quot;[#RadialActions.exe]&quot;"
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="NOT Installed" />
    </InstallExecuteSequence>
  </Package>
</Wix>
